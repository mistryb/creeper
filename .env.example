APP_NAME=Creeper
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
# Sign-in is by emailed code, and a successful sign-in also sets a remember
# cookie that lasts about a year. This is only how long a session survives
# without activity before that cookie has to re-establish it.
SESSION_LIFETIME=20160
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Must stay longer than the longest job timeout, or a slow digest gets handed
# to a second worker and is written — and paid for, and emailed — twice.
DB_QUEUE_RETRY_AFTER=330

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Sending for real. Set MAIL_MAILER=resend and put the key here; the SMTP
# defaults above talk to Mailpit, which needs no key and never leaves the
# machine. Sign-in is an emailed code, so an install whose mail does not
# work is an install nobody can get into.
RESEND_API_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

###############################################################################
# Creeper
###############################################################################

# The model that finds competitors and writes digests.
#
# The provider travels with the key, and keys are added in the app rather than
# here — each user adds theirs under Settings → API keys and picks one per
# company. There is nothing to paste into an environment file, and nothing for
# an error page's config dump to leak. Leave the model blank to take whatever
# the provider's own default is.
DIGEST_MODEL=

# How long one model call may run, in seconds. Must stay well inside the job
# timeout (300), which must stay inside DB_QUEUE_RETRY_AFTER above.
DIGEST_TIMEOUT=180

# How many web searches one run may make. This is the cost dial: every search
# is billed to the user's key alongside the tokens it returns.
DIGEST_MAX_SEARCHES=12
DIGEST_DISCOVERY_MAX_SEARCHES=8

# The most competitors discovery will put on a company's list.
DIGEST_DISCOVERY_MAX_COMPETITORS=8

# Reading the company's own homepage before discovery. Seconds, characters.
DIGEST_FETCH_TIMEOUT=15
DIGEST_FETCH_MAX_CHARACTERS=8000

###############################################################################
# Sign-in
###############################################################################

# Who is allowed an account, comma separated. Signing in and signing up are
# the same act here, so an empty list means anybody who can read mail at an
# address can have an account — fine for a public install, not for a private
# one. Name yourself here, and add somebody by editing this and redeploying.
#
# Unlisted addresses are turned away without being told so: they get the same
# screen as everybody else and simply never receive a code.
AUTHORIZED_EMAILS=

# Running locally signs you in by itself: an account is created on the first
# request and authenticated, so there is no code to wait for on your own
# machine. Only ever true in the "local" environment. Turn it off to walk
# through the real sign-in flow.
LOCAL_AUTO_SIGN_IN=true

# Who that account belongs to. Leave it blank and a restricted install uses
# the first address in AUTHORIZED_EMAILS, while an unrestricted one reuses the
# account already in the database.
LOCAL_USER_EMAIL=

# Who can open the admin panel at /admin, comma separated. Empty means
# nobody. On a private install these addresses must be authorized above too.
ADMIN_EMAILS=

###############################################################################
# Billing
###############################################################################

# Leave these empty and Creeper runs self-hosted: no plans, no trial, no limit
# on companies. Fill in the secret and both prices and it charges: a 7-day
# card-free trial covering one company, then $5/month for one company or
# $20/month for unlimited. Subscriptions only reach the app by webhook, so
# the webhook secret is required. Locally, `composer run dev` runs
# `stripe listen` for you when the Stripe CLI is installed — put the secret
# from `stripe listen --print-secret` here. In production, create the endpoint
# with `php artisan cashier:webhook` and use the secret it is given.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_SINGLE=
STRIPE_PRICE_UNLIMITED=
CASHIER_CURRENCY=usd

###############################################################################
# Marketing
###############################################################################

# Off by default, which makes "/" the sign-in page — what a self-hosted or
# private install wants, since everyone arriving already has an account. Turn
# it on to serve the marketing landing page there instead.
MARKETING_MODE=false

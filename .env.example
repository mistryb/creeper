APP_NAME=Creeper
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
# Sign-in is by emailed code, and a successful sign-in also sets a remember
# cookie that lasts about a year. This is only how long a session survives
# without activity before that cookie has to re-establish it.
SESSION_LIFETIME=20160
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# Must stay longer than the longest job timeout, or a slow creep gets handed to
# a second worker and the target is crept — and paid for — twice.
DB_QUEUE_RETRY_AFTER=330

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

###############################################################################
# Creeper
###############################################################################

# Which driver actually does the creeping.
#
#   llm   fetches each page and reads it with a model. The default, and what
#         you want — but it needs a key, either CREEP_LLM_API_KEY below or one
#         each user adds in settings. Without one, runs fail saying so.
#   fake  invents plausible product data locally. Needs no key at all, so this
#         is how to look around before committing to a provider.
#   http  hands each URL to your own creeping agent over HTTP.
CREEP_DRIVER=llm

# Your creeping agent. Only used when CREEP_DRIVER=http.
CREEP_AGENT_ENDPOINT=
CREEP_AGENT_TOKEN=
CREEP_AGENT_TIMEOUT=120

# The model that reads pages when CREEP_DRIVER=llm.
#
# Users who add their own key in settings choose their own provider with it,
# and that always wins. This key is the fallback — the one a self-hosted
# install runs on. Leave the model blank to take the provider's own default.
#
# Providers: anthropic, openai, gemini, groq, openrouter
CREEP_LLM_PROVIDER=anthropic
CREEP_LLM_MODEL=
CREEP_LLM_API_KEY=

# How much of a page the model is asked to read, in characters. This is the
# cost dial: lower is cheaper per run and likelier to miss something.
CREEP_LLM_MAX_CHARACTERS=12000

# Fetching and inference together must finish inside the budget, so that a run
# never outlives its queue reservation. Seconds.
CREEP_LLM_BUDGET=70
CREEP_LLM_TIMEOUT=45
CREEP_LLM_FETCH_TIMEOUT=15

# How long an asynchronous agent has to post results back to a run's signed
# callback URL, in minutes.
CREEP_CALLBACK_TTL=180

# How many times a failing creep is retried before the run is marked failed.
CREEP_RETRIES=3

###############################################################################
# Marketing
###############################################################################

# Off by default, which makes "/" the sign-in page — what a self-hosted or
# private install wants, since everyone arriving already has an account. Turn
# it on to serve the marketing landing page there instead.
MARKETING_MODE=false
